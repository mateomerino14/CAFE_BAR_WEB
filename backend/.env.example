PORT=3000

# Base de datos (Postgres local, embebido o instalado en la PC del local)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cafebar

JWT_SECRET=
JWT_EXPIRES_IN=8h

# Nota: las credenciales de Brevo (envío de correos) YA NO van aquí — se configuran desde
# dentro de la propia app (Configuración → Configurar Envío de Correos) y se guardan en la
# base de datos, para poder cambiarlas sin reiniciar nada.

ALLOWED_IPS=

# Carpeta y URL base donde se guardan/sirven las imágenes subidas (productos, empleados, etc.)
UPLOADS_DIR=
UPLOADS_PUBLIC_URL=http://localhost:3000/uploads
